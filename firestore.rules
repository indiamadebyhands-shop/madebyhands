rules_version = '2';

// Security rules for MadeByHands. Deploy with:
//   firebase deploy --only firestore:rules
//
// Anything financial (orders, payment intents, receipts, refunds, stock
// decrements at purchase) is written by the payment API through the Admin
// SDK, which bypasses these rules. Clients can never create orders.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isRootSuperAdminEmail() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'adhirajjain364@gmail.com',
          'mayankjaisw8673@gmail.com',
          'suhanimahajan2810@gmail.com',
          'majumdarpayal50@gmail.com',
          'reshob.rc12345@gmail.com'
        ];
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(userPath())
        ? get(userPath()).data.get('role', '')
        : '';
    }

    function isSuperAdmin() {
      return isRootSuperAdminEmail() || role() == 'super_admin';
    }

    function isAdminOrManager() {
      return isSuperAdmin() || role() in ['admin', 'manager'];
    }

    // Suspension must actually stop a user from writing, not just hide the
    // UI behind a blocking screen (/api/suspend-user.js is what sets this
    // flag, and also disables their Firebase Auth account). Admin/manager
    // actions are never gated by this — only a user's own self-service
    // writes are.
    function isSuspended() {
      return signedIn() && exists(userPath()) &&
        get(userPath()).data.get('isSuspended', false) == true;
    }

    function creatorModerationLevel() {
      return signedIn() && exists(userPath())
        ? get(userPath()).data.get('creatorModerationLevel', 0)
        : 0;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOwnProduct() {
      return resource.data.get('creatorUid', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdminOrManager());

      // Self sign-up may only choose buyer or creator. The preset super-admin
      // emails may bootstrap an admin profile.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('uid', userId) == userId &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isSuspended', false) == false &&
        ((request.resource.data.role in ['buyer', 'creator'] &&
          request.resource.data.get('roles', [request.resource.data.role])
            .hasOnly(['buyer', 'creator']) &&
          request.resource.data.get('roles', [request.resource.data.role])
            .hasAll([request.resource.data.role])) ||
          (request.resource.data.role == 'admin' && isRootSuperAdminEmail()));

      // Super admins manage roles. Managers may moderate (verify, suspend)
      // but never change anyone's role. Users edit only their contact info.
      allow update: if isSuperAdmin() ||
        (isAdminOrManager() && !changedKeys().hasAny(['role', 'roles'])) ||
        (signedIn() && request.auth.uid == userId &&
          resource.data.role in ['buyer', 'creator', 'seller'] &&
          changedKeys().hasOnly([
            'name', 'phone', 'email', 'updatedAt', 'role', 'roles'
          ]) &&
          request.resource.data.role in ['buyer', 'creator'] &&
          request.resource.data.get('roles', []).hasOnly(['buyer', 'creator']) &&
          request.resource.data.get('roles', []).hasAll([
            request.resource.data.role
          ]) &&
          request.resource.data.get('roles', []).hasAll(
            resource.data.get(
              'roles',
              [resource.data.role == 'seller' ? 'creator' : resource.data.role]
            )
          ));

      allow delete: if signedIn() && (request.auth.uid == userId || isAdminOrManager());

      match /favorites/{productId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /addresses/{addressId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // --------------------------------------------------------------- products

    match /products/{productId} {
      allow read: if signedIn();

      // New listings always start hidden and pending admin approval.
      allow create: if isAdminOrManager() ||
        (signedIn() && !isSuspended() && creatorModerationLevel() < 2 &&
          request.resource.data.creatorUid == request.auth.uid &&
          request.resource.data.status == 'Pending Approval' &&
          request.resource.data.isActive == false &&
          get(/databases/$(database)/documents/creator_profiles/$(request.auth.uid)).data.get('verificationStatus', '') == 'Verified');

      allow update: if isAdminOrManager() ||
        // Creator edits go back to review and stay hidden until approved.
        (signedIn() && !isSuspended() && isOwnProduct() &&
          request.resource.data.get('creatorUid', '') == resource.data.get('creatorUid', '') &&
          request.resource.data.status == 'Pending Approval' &&
          request.resource.data.isActive == false &&
          request.resource.data.get('orderCount', 0) == resource.data.get('orderCount', 0) &&
          request.resource.data.get('wishlistCount', 0) == resource.data.get('wishlistCount', 0)) ||
        // Creators may publish/unpublish approved listings and adjust stock.
        (signedIn() && !isSuspended() && creatorModerationLevel() < 2 && isOwnProduct() &&
          changedKeys().hasOnly(['isActive', 'stock', 'updatedAt']) &&
          (request.resource.data.isActive == false ||
            (resource.data.status == 'Approved' &&
              get(/databases/$(database)/documents/creator_profiles/$(request.auth.uid)).data.get('verificationStatus', '') == 'Verified')) &&
          request.resource.data.stock is int &&
          request.resource.data.stock >= 0) ||
        // Any shopper can move the wishlist counter by exactly one.
        (signedIn() &&
          changedKeys().hasOnly(['wishlistCount']) &&
          request.resource.data.wishlistCount is int &&
          (request.resource.data.wishlistCount - resource.data.get('wishlistCount', 0)) in [1, -1]);

      allow delete: if isAdminOrManager() || (signedIn() && isOwnProduct());

      match /reviews/{buyerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && !isSuspended() &&
          request.auth.uid == buyerId &&
          request.resource.data.buyerId == buyerId &&
          request.resource.data.productId == productId &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() >= 3 &&
          request.resource.data.comment.size() <= 1000;
        allow delete: if isAdminOrManager();
      }
    }

    // ----------------------------------------------------------------- orders

    match /orders/{orderId} {
      // Orders are created only by /api/finalize-payment (Admin SDK).
      allow create: if false;

      allow read: if signedIn() && (
        isAdminOrManager() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );

      // Rejections and refunds go through /api/reject-order. Creators move a
      // live order through fulfilment; payout fields are super-admin only.
      allow update: if isSuperAdmin() ||
        (isAdminOrManager() &&
          !changedKeys().hasAny(['payoutStatus', 'payoutReleasedAt', 'paidAt', 'paymentStatus', 'refundStatus'])) ||
        (signedIn() && !isSuspended() &&
          resource.data.creatorId == request.auth.uid &&
          !(resource.data.status in ['Rejected', 'Cancelled']) &&
          changedKeys().hasOnly(['status', 'updatedAt', 'consignmentNumber', 'carrierName', 'deliveredAt']) &&
          request.resource.data.status in ['Confirmed', 'Processing', 'In-Transit', 'Shipped', 'Out for Delivery', 'Delivered']);

      allow delete: if isSuperAdmin();
    }

    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }

    match /paymentReceipts/{paymentId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- support

    match /support_tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (isAdminOrManager() || resource.data.userId == request.auth.uid);
      allow update: if isAdminOrManager() ||
        (signedIn() &&
          resource.data.userId == request.auth.uid &&
          changedKeys().hasOnly(['lastMessage', 'updatedAt']));
      allow delete: if isAdminOrManager();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdminOrManager() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
        );
        // getAfter so the first message can be written in the same batch
        // that creates the ticket.
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (isAdminOrManager() ||
            getAfter(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    // --------------------------------------------------------------- platform

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdminOrManager();
    }

    // --------------------------------------------------------------- creators

    // Public studio profile. Creators cannot mark themselves verified.
    match /creator_profiles/{creatorId} {
      allow read: if signedIn();
      allow create: if isAdminOrManager() ||
        (signedIn() && request.auth.uid == creatorId &&
          request.resource.data.get('isStorefrontVisible', true) == true &&
          !request.resource.data.keys().hasAny(['moderationLevel']) &&
          request.resource.data.get('verificationStatus', 'Unverified') in ['Unverified', 'In-Process']);
      allow update: if isAdminOrManager() ||
        (signedIn() && request.auth.uid == creatorId &&
          !changedKeys().hasAny(['isStorefrontVisible', 'moderationLevel']) &&
          (request.resource.data.get('verificationStatus', 'Unverified') == resource.data.get('verificationStatus', 'Unverified') ||
            request.resource.data.get('verificationStatus', 'Unverified') in ['Unverified', 'In-Process']));
      allow delete: if isAdminOrManager() || (signedIn() && request.auth.uid == creatorId);
    }

    // Private verification documents (ID, photo, address).
    match /creator_verifications/{creatorId} {
      allow read, write: if isAdminOrManager() || (signedIn() && request.auth.uid == creatorId);
    }

    // Payout details are visible to the creator and to super admins only.
    match /creator_bank_accounts/{creatorId} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == creatorId);
      allow write: if signedIn() && request.auth.uid == creatorId;
      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == creatorId);
    }

    // ---------------------------------------------------------- notifications

    match /notifications/{notificationId} {
      // Owners are matched on the field their inbox query filters by
      // (creatorUid for creators, userId for buyers) so list queries pass.
      allow read: if signedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdminOrManager()
      );

      // Admins notify anyone. Other users may raise an admin alert or create
      // the confirmation for a support ticket that belongs to themselves.
      allow create: if isAdminOrManager() ||
        (signedIn() &&
          request.resource.data.type == 'admin' &&
          !('creatorUid' in request.resource.data) &&
          !('userId' in request.resource.data)) ||
        (signedIn() &&
          request.resource.data.type == 'support' &&
          request.resource.data.category == 'support_ticket' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.creatorUid == request.auth.uid &&
          request.resource.data.ticketId == request.resource.data.targetId &&
          request.resource.data.isRead == false &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.keys().hasOnly([
            'userId', 'creatorUid', 'type', 'category', 'title', 'message',
            'targetId', 'ticketId', 'createdAt', 'isRead'
          ]) &&
          getAfter(/databases/$(database)/documents/support_tickets/$(request.resource.data.targetId)).data.userId == request.auth.uid);

      allow update: if isAdminOrManager() ||
        (signedIn() &&
          (resource.data.creatorUid == request.auth.uid ||
            resource.data.userId == request.auth.uid) &&
          changedKeys().hasOnly(['isRead']));

      allow delete: if isAdminOrManager() ||
        (signedIn() &&
          (resource.data.creatorUid == request.auth.uid ||
            resource.data.userId == request.auth.uid));
    }

    // ------------------------------------------------------ account deletions

    // Admin activity log: one append-only entry per change an admin or manager
    // makes in the panel. Written by the acting admin themselves (never on
    // someone else's behalf), readable only by super admins, and immutable.
    match /admin_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminOrManager() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'actorEmail', 'actorRole',
          'action', 'category', 'summary', 'targetId', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    // A one-way log of why someone deleted their account, written by the
    // departing user themselves just before their account is removed.
    // Write-only from the client: nobody can read, edit, or delete these
    // through the app (super admins read them directly in the console).
    match /account_deletions/{entryId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

  }
}
